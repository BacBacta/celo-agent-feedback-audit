                            </div>

                            <div class="flex-grow-1 small">
                                 Learn more about <a target="_blank" href="https://info.etherscan.com/connecting-your-wallet-on-etherscan/">connecting your wallet on  celoscan</a>.
                            </div>
                        </li>

                    </ul>

                    <div class="text-center my-4">
                        <button type="button" class="btn btn-lg btn-primary" data-bs-dismiss="modal" onclick="openAfterWalletDisclaimerModal(); return false;">Understand and Continue</button>
                    </div>
                </div>
            </div>
