                    $("#noteUD").html('The Unstoppable Domains NFT is minted on the Ethereum blockchain. View and verify its details on <a target="_blank" href="https://etherscan.io/name-lookup-search?id=' + primaryUDName + '">Etherscan</a>.');
                    $("#noteUD").show();
