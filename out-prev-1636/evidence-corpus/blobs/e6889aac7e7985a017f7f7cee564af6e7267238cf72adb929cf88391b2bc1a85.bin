            $('#udName').on('hide.bs.popover', () => {
                $("[data-bs-toggle='tooltip']").tooltip('hide');
            });

            // Hide Unstoppable Domains Name popover when click outside the popover popup.
            $(document).click(function () {
                $("#udName").popover('hide')
            });
        }
