                        <i class='far fa-exclamation-triangle'></i>
                        
                        <span>${unicodeWarningMessage} Check the actual text at <a target='_blank' href='https://app.ens.domains/name/${$("#hdnEnsText").val()}'>ENS</a>.</span>
                        
