],"name":"sessionKeyOf","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint16","name":"newBps","type":"uint16"}],"name":"setProtocolFee","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"key","type":"address"}],"name":"setSessionKey","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newTreasury","type":"address"}],"name":"setTreasury","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"arenaId","type":"uint256"}],"name":"settle","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"treasury","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"unpause","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"},{"internalType":"bytes","name":"data","type":"bytes"}],"name":"upgradeToAndCall","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"version","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"pure","type":"function"},{"inputs":[{"internalType":"contract IERC20","name":"token","type":"address"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"}]';
        var LitAdvancedModeAvailable = true;
        var isUniswapV3Decode = "";
        var isAATx = false;
        var preLink = '';
        var target_rawtab = "rawtab"
        var target_decodetab = "decodetab"
        var target_decodebox = "decodebox"
        var target_inputDecode = "inputDecode"
        var target_loadingtxframe = "loadingtxframe"
        if (isAATx) {
            target_rawtab = "AA_rawtab"
            target_decodetab = "AA_decodetab"
            target_decodebox = "AA_decodebox"
            target_inputDecode = "AA_inputDecode"
            target_loadingtxframe = "AA_loadingtxframe"
        }

        // parse and update ABI if exists
        if (LitContractABI != "Contract source code not verified") {
            LitContractABI = JSON.parse(LitContractABI);
        } else {
            LitContractABI = {};
        }

        //var checkBox = document.getElementById("customSwitch1");
        //var toggletext = document.getElementById("toggletext");

        //if (LitAdvancedModeAvailable == false) {
        //    //need to disable advanced mode toggle
        //    if (document.getElementById("ContentPlaceHolder1_divswitch")) {
        //        document.getElementById("divswitch").style.display = "none";;
        //    }
        //} else {
        //    var baseUrlcheck = window.location.href.toLowerCase();
        //    if (baseUrlcheck.includes("/advanced") == true) {
        //        document.getElementById("customSwitch1").checked = true;
        //        toggletext.innerHTML = "ADVANCED MODE:";
        //    }
        //}

        if (LitAdvancedModeAvailable == true) {
            var baseUrlcheck = window.location.href.toLowerCase();
            if (baseUrlcheck.includes("/advanced") == true) {
                document.getElementById("customSwitch1").checked = true;
            }
        }
        
        convertUtcTimestampToLocalTime();

        function toggleMode() {
            var checkBox = document.getElementById("customSwitch1");
            var toggletext = document.getElementById("toggletext");
            // If the checkbox is checked, display the output text
            var baseUrl = window.location.href.split('#')[0].toLowerCase();;            
            if (checkBox.checked == false) {
                toggletext.innerHTML = "ADVANCED MODE:";
                history.replaceState("", document.title, baseUrl.replace("/advanced", "") + '#internal');
                window.location.reload();
            } else {
                toggletext.innerHTML = "ADVANCED MODE:";
                history.replaceState("", document.title, baseUrl + '/advanced#internal');
                window.location.reload();
            }
        }            

    </script>
    <script type="text/javascript" src="/assets/js/custom/txpage.js?v=26.8.3.0"></script>
    <script type="text/javascript" src="/assets/js/custom/common-tools.js?v=26.8.3.0"></script>
     
    
    <script type="text/javascript">
        (function () {
            // POPOVER
            // =======================================================
            const popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
            popoverTriggerList.map((el) => {
                let opts = {
                    animation: true,
                }
                if (el.hasAttribute('data-bs-content-id')) {
                    opts.content = document.getElementById(el.getAttribute('data-bs-content-id'))
                        .innerHTML
                        .replace(/data-cfsrc/g, 'src')
                        .replace(/style="display:none;visibility:hidden;"/g, '');
                    opts.html = true;
                }
                new bootstrap.Popover(el, opts);
            })
        })();

        (function () {
            // TOGGLE IMAGE PREVIEW
            // =======================================================
            const PREVIEW_DURATION_MS = 10000; // 10 seconds

            document.querySelectorAll('.js-toggle-image-preview').forEach(function (preview) {
                const img = preview.querySelector('.js-toggle-image');
                const icon = preview.querySelector('.js-toggle-image-icon');
                // Tooltip instance bound to the preview anchor (if any)
                let tooltipInstance = null;
                let timeoutId = null;

                function disableTooltip() {
                    // The preview anchor itself has the tooltip attributes
                    const tooltipElement = preview.matches('[data-bs-toggle="tooltip"]') ? preview : preview.closest('[data-bs-toggle="tooltip"]');
                    if (!tooltipElement || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;

                    tooltipInstance = bootstrap.Tooltip.getInstance(tooltipElement) || new bootstrap.Tooltip(tooltipElement);
                    try { tooltipInstance.hide(); } catch (e) { }
                    try { tooltipInstance.disable(); } catch (e) { }
                }

                function enableTooltip() {
                    if (!tooltipInstance) return;
                    try { tooltipInstance.enable(); } catch (e) { }
                    tooltipInstance = null;
                }

                function resetPreview() {
                    if (img) img.style.filter = 'blur(20px)';
                    if (icon) icon.classList.remove('d-none');
                    preview.dataset.previewActive = '0';
                    // Re-enable tooltip after reset
                    enableTooltip();
                    timeoutId = null;
                }

                preview.addEventListener('click', function (e) {
                    e.preventDefault();

                    // If already active, ignore click until it auto-resets
                    if (preview.dataset.previewActive === '1') {
                        return;
                    }

                    // Reveal image and hide icon
                    if (img) img.style.filter = '';
                    if (icon) icon.classList.add('d-none');
                    preview.dataset.previewActive = '1';

                    // Hide and disable tooltip while preview is active
                    disableTooltip();

                    // Auto-revert after 10s
                    timeoutId = window.setTimeout(resetPreview, PREVIEW_DURATION_MS);
                });
            });
        })();


        $(document).ready(function () {
            var rawinput = $('#rawinput').text()
            var convertedInput = hex2utf8(rawinput);

            if (convertedInput.startsWith("data:text") || convertedInput.startsWith("data:image")) {
                var existingImage = $("#txaImage");
                var imgConverted = base64ToImage(convertedInput);
                imgConverted.style.width = '40px';
                imgConverted.style.height = '40px';

                //existingImage.attr("src", imgConverted.src);
                existingImage.empty();
                existingImage.append(imgConverted);

                $('#defaultTxActionImage').hide();
                $('#customTxActionImage').show();

                $('#li_convertImage').css('display', 'block');

            }

            fix_popover_view_detail();
        });

        function fix_popover_view_detail() {
            const el = document.querySelector('#showmore_detailtx');
            if (el) {
                bootstrap.Popover.getInstance(el)?.dispose();
                const isHoverDevice = window.matchMedia('(hover: hover)').matches;
                const popover = new bootstrap.Popover(el, {
                    trigger: 'manual',
                    html: true,
                    placement: 'top',
                    fallbackPlacements: ['bottom'],
                    content: "Turn on Advanced Mode in <a target='_blank' href='/settings'>Site Settings</a> to display more details by default."
                });
                let isOpen = false;
                let isHoveringPopover = false;
                let isShown = false;
                el.addEventListener('mouseenter', () => {
                    if (!isShown) {
                        popover.show();
                        isShown = true;
                    }
                });
                el.addEventListener('mouseleave', () => {
                    setTimeout(() => {
                        if (!isHoveringPopover) {
                            popover.hide();
                            isShown = false;
                        }
                    }, 100);
                });
                el.addEventListener('shown.bs.popover', () => {
                    const tip = popover.tip;
                    if (!tip) return;
                    tip.addEventListener('mouseenter', () => {
                        isHoveringPopover = true;
                    });
                    tip.addEventListener('mouseleave', () => {
                        isHoveringPopover = false;
                        popover.hide();
                        isShown = false;
                    });
                });

            }
        }

        function convertImage() {
            var rawinput = $('#rawinput').text()
            var convertedInput = hex2utf8(rawinput);

            if (convertedInput.startsWith("data:text") || convertedInput.startsWith("data:image")) {
                var existingImage = $("#imagePreview");
                var imgConverted = base64ToImage(convertedInput);
                imgConverted.style.maxWidth = '200px';
                imgConverted.style.maxHeight = '150px';
                imgConverted.style.width = 'auto';
                imgConverted.style.height = 'auto';

                //existingImage.attr("src", imgConverted.src);
                existingImage.empty();
                existingImage.append(imgConverted);

                $('#textdiv').hide();
                $('#decodetab').hide();
                $('#imagediv').show();

                $('#convert_utf').removeClass('active');
                $('#convert_original').removeClass('active');
                $('#convert_default').removeClass('active');

                $('#convert_image').addClass('active');
            }
        }


        let tb_internaltx_control = []
        $('#ContentPlaceHolder1_divinternaltable tbody').on('click', 'td.tb_internaltx_control', function () {
            var td_id = this.id;
            $("[data-bs-toggle='tooltip']").tooltip('dispose');
            var tr = $(this).parent('tr').next('tr');
            if (tr.is(':visible')) {
                tr.hide();
                $('#' + td_id)[0].innerHTML = "<button type='button' class='btn btn-sm btn-icon btn-secondary' data-bs-toggle='tooltip' title='Click to see more'><i class='fa fa-chevron-down'></i></button>";
                this.parentNode.className = 'plus';
            } else {
                tr.show();
                $('#' + td_id)[0].innerHTML = "<button type='button' class='btn btn-sm btn-icon btn-secondary' data-bs-toggle='tooltip' title='Click to see less'><i class='fa fa-chevron-up'></i></button>";
                this.parentNode.className = 'minus table-active';
            }
            if (!tb_internaltx_control.includes(td_id)) {
                var el_index = this.id.replace("tb_internaltx_", "");
                var param_id = $('#' + td_id).data('getinputdata');
                var baseUrlcheck = window.location.href.toLowerCase();
                var mode = ""
                if (baseUrlcheck.includes("/advanced") == true) {
                    mode = "advanced"
                }
                var data = {
                    mode: mode,
                    id: param_id,
                    index: el_index
                }
                $.ajax({
                    type: 'Get',
                    url: '/txsHandler.ashx',
                    data: { action: "internalTx", data: JSON.stringify(data) },
                }).done(function (data, textStatus, xhr) {
                    $('#tb_internaltx_ttd' + el_index).html(data)
                    $("[data-bs-toggle='tooltip']").tooltip();
                });
            }
            tb_internaltx_control.push(td_id)
        });
        function submitInputDecoderForm(anchor) {
            const tmp = anchor.getAttribute('data-paramdecoder')
            const params = JSON.parse(tmp || '{ }');
            const address = params.address || '';
            const inputdata = params.inputdata || '';
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/inputdatadecoder';
            form.target = '';
            const addField = (name, value) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                form.appendChild(input);
            };
            addField('address', address);
            addField('inputdata', inputdata);
            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form); // cleanup
        }

        $('.tooltip-address').on('inserted.bs.tooltip', function () {
            $("body div.tooltip-inner").css("max-width", "290px");
        });

        window.mode = 'light';
        var litTxHash = "0xc82273384534286b9d8a769d083834c21f63981e8ea82d9e3ececac090b65ac6";

        function btnDecodeClick(options) {
            var elrawtab = options && options.rawtab ? options.rawtab : target_rawtab;
            var eldecodetab = options && options.decodetab ? options.decodetab : target_decodetab;
            $("#" + elrawtab).hide();
            document.getElementById(eldecodetab).removeAttribute("style");
            $("#" + eldecodetab).show();
        }
        function btnSwitchClick(options) {
            var elrawtab = options && options.rawtab ? options.rawtab : target_rawtab;
            var eldecodetab = options && options.decodetab ? options.decodetab : target_decodetab;
            $("#" + eldecodetab).hide();
            $("#" + elrawtab).show();
        }

        //-- begin code for checking for disqus comments---
        var blnCheckDisqusCount = false;
        if (blnCheckDisqusCount == true) {
            checkdisquscomment();
        }

        function checkdisquscomment() {
            $.ajax({
                type: 'Get',
                url: '/datahandler.ashx',
                data: {
                    t: 'disqcommentchck',
                    id: disqus_title,
                    type: 'tx'
                },
                success: function (res) {
                    //console.log("checkdisquscomment res=" + res);
                    if (res == 1) {
                        document.getElementById("commentindicator").innerHTML = "<sup><i class='fas fa-circle text-success ms-1' title='There are comment(s) for this item'></i></sup>"
                    }
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                }
            });
        }
        //-- End code for checking for disqus comments---

        if (document.querySelector('.scrollbar-custom')) {
            const allscrollbar = document.querySelectorAll(".scrollbar-custom");
            for (let i = 0; i < allscrollbar.length; i++) {
                allscrollbar[i].addEventListener('scroll', function (e) {
                    if (document.querySelector('.bs-tooltip-auto')) {
                        let targetedElem = document.querySelector(`[aria-describedby='${document.querySelector('.bs-tooltip-auto').getAttribute('id')}']`);
                        let tooltipTemp = bootstrap.Tooltip.getOrCreateInstance(targetedElem);
                        tooltipTemp.hide();
                    }
                })
            }
        }

        window.addEventListener("pageshow", function (e) {
            function goToLine() {
                var line = preLink;
                preLink = '';
                if (!line) {
                    return;
                }

                var scrollDiv = document.getElementById('logI_' + line);
                scrollDiv.style.borderStyle = 'solid';
                scrollDiv.style.borderColor = '#0784c3';
                //scrollDiv.scrollIntoView();
                var targetPosition = scrollDiv.getBoundingClientRect().top + window.pageYOffset - 80;
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }

            setTimeout(function () {
                goToLine();
            }, 500);
        });

        function normalizeEventInputsForDecoding(inputs) {
            return inputs.map(input => {
                const normalizedInput = { ...input };
                if (normalizedInput.type === "function" || normalizedInput.type.startsWith("function[")) {
                    normalizedInput.type = "bytes24" + normalizedInput.type.substring("function".length);
                }
                if (Array.isArray(normalizedInput.components)) {
                    normalizedInput.components = normalizeEventInputsForDecoding(normalizedInput.components);
                }
                return normalizedInput;
            });
        }

        function decodeevent(eventcount) {
            var input_data = $("#event_raw_data_" + eventcount).text();
            var abi = "";
            var abilist = $("#abi_hiddenField").text();
            var topic0 = $("#topic0_hiddenField_" + eventcount).text();
            var topic1 = $("#topic1_hiddenField_" + eventcount).text();
            var topic2 = $("#topic2_hiddenField_" + eventcount).text();
            var topic3 = $("#topic3_hiddenField_" + eventcount).text();
            var address = $("#address_hiddenField_" + eventcount).text();
            var eventName = $("#eventName_hiddenField_" + eventcount).text();
            var paramFlag = $("#paramFlag_hiddenField_" + eventcount).text();

            var strhtml = "";
            const topics = [topic0, topic1, topic2, topic3].filter(topic => topic.length > 0);
            if (topics.length > 0) {
                try {
                    abilist = JSON.parse(abilist);
                    abi = JSON.parse(abilist[topic0 + "_" + address]);
                } catch {
                    abi = ""
                    strhtml = "<li class='d-lg-flex' style='padding-bottom:0.5em'><span class='text-muted rounded me-1 text-truncate'>Invalid abi</span></li>";
                }
                if (abi != "") {
                    var web3 = new Web3;
                    const eventSignature = web3.eth.abi.encodeEventSignature(abi);
                    if (topic0 !== eventSignature) {
                        strhtml = "<li class='d-lg-flex' style='padding-bottom:0.5em'><span class='text-muted rounded me-1 text-truncate'>Topic0 does not match the signature of event</span></li>";
                    } else {
                        try {
                            const decodedLog = web3.eth.abi.decodeLog(
                                normalizeEventInputsForDecoding(abi.inputs),
                                input_data,
                                topics.slice(1)
                            );
                            //form div
                            strhtml = decodeeventinputweb3(decodedLog, abi, paramFlag)
                        } catch {
                            strhtml = "<li class='d-lg-flex' style='padding-bottom:0.5em'><span class='text-muted rounded me-1 text-truncate'>Fail Decode Event Log</span></li>";
                        }
                    }
                }
            } else {
                strhtml = "<li class='d-lg-flex' style='padding-bottom:0.5em'><span class='text-muted rounded me-1 text-truncate'>Empty topic0 signature of event</span></li>";
            }
            $('#event_achoc_' + eventcount).empty();
            $('#event_achoc_' + eventcount).prepend(strhtml);
            $('#event_achoc_' + eventcount).show();
            $('#event_dec_data_' + eventcount).hide();
            $('#event_raw_data_' + eventcount).hide();

            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl))
        }

        document.querySelectorAll('.log-detail .dropdown-toggle').forEach(toggle => {
            const menu = toggle.parentElement.querySelector('.dropdown-menu');
            if (!menu) {
                return;
            }
            const originalParent = menu.parentElement;
            const nextSibling = menu.nextElementSibling;
            toggle.addEventListener('shown.bs.dropdown', () => {
                const { left, bottom } = toggle.getBoundingClientRect();
                document.body.appendChild(menu);
                Object.assign(menu.style, {
                    position: 'absolute',
                    left: `${left}px`,
                    top: `${bottom}px`,
                    width: `${toggle.offsetWidth}px`
                });
            });
            toggle.addEventListener('hidden.bs.dropdown', () => {
                if (nextSibling) {
                    originalParent.insertBefore(menu, nextSibling);
                } else {
                    originalParent.appendChild(menu);
                }
                Object.assign(menu.style, { position: '', left: '', top: '', width: '' });
            });
        });

        document.addEventListener("DOMContentLoaded", function () {
            initTimestampSwitcher("showUtcLocalDate", "tsMode", "copyTS");
        });

        // Tx Insight
        // =======================================================
        var insightTransition = 'max-height 0.35s ease';
        window.toggleAiInsight = function (btn) {
            var t = document.getElementById('js-insight-text');
            if (!t || t.dataset.canToggle !== 'true') return;
            var expanded = t.dataset.expanded === 'true';
            if (expanded) {
                t.style.maxHeight = t.dataset.collapsedHeight;
                t.dataset.expanded = 'false';
                btn.textContent = 'Show more';
            } else {
                t.style.transition = 'none';
                t.style.maxHeight = 'none';
                var fullH = t.scrollHeight + 'px';
                t.style.maxHeight = t.dataset.collapsedHeight;
                t.offsetHeight;
                t.style.transition = insightTransition;
                t.style.maxHeight = fullH;
                t.dataset.expanded = 'true';
                btn.textContent = 'Show less';
            }
        }

        function syncAiInsightToggle() {
            var t = document.getElementById('js-insight-text');
            if (!t) return;
            var insightWrap = t.parentElement;
            var insightBtn = insightWrap ? insightWrap.querySelector('[onclick*="toggleAiInsight"]') : null;
            var lh = parseFloat(getComputedStyle(t).lineHeight) || 20;
            var collapsedPx = lh * 2;
            var collapsed = collapsedPx + 'px';
            var expanded = t.dataset.expanded === 'true';
            t.style.transition = 'none';
            t.style.maxHeight = 'none';
            var fullH = t.scrollHeight;
            var canToggle = fullH > (collapsedPx + 4);
            t.dataset.collapsedHeight = collapsed;
            t.dataset.canToggle = canToggle ? 'true' : 'false';
            if (!canToggle) {
                t.style.maxHeight = 'none';
                t.dataset.expanded = 'false';
                if (insightBtn) insightBtn.classList.add('d-none');
                t.style.transition = insightTransition;
                return;
            }
            if (insightBtn) {
                insightBtn.classList.remove('d-none');
                insightBtn.textContent = expanded ? 'Show less' : 'Show more';
            }
            t.style.maxHeight = expanded ? (fullH + 'px') : collapsed;
            t.dataset.expanded = expanded ? 'true' : 'false';
            t.style.transition = insightTransition;
        }
        syncAiInsightToggle();
        window.addEventListener('resize', syncAiInsightToggle);
    </script> 


</body>
</html>
