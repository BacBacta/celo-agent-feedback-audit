    <!-- Canonical is set per-route via react-helmet-async -->
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://loopuman.com/#organization",
          "name": "Loopuman",
          "legalName": "Agentic Eye Limited",
          "alternateName": "Loopuman - The Human Layer for AI",
          "url": "https://loopuman.com",
          "logo": "https://loopuman.com/favicon-512x512.png",
          "description": "The Human Layer for AI. A blockchain-powered microtasking platform connecting AI agents and requesters with verified human workers worldwide.",
          "email": "support@loopuman.com",
          "foundingDate": "2025",
          "slogan": "The Human Layer for AI",
          "knowsAbout": ["AI agents", "microtasks", "human-in-the-loop", "data labeling", "blockchain payments", "Celo", "MCP server", "agent economy"],
          "sameAs": [
            "https://t.me/Loopuman_Bot",
            "https://twitter.com/loopuman",
            "https://github.com/seesayearn-boop",
            "https://www.facebook.com/loopuman",
            "https://www.instagram.com/loopuman",
            "https://www.youtube.com/@Loopuman",
            "https://www.linkedin.com/company/loopuman"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "email": "support@loopuman.com",
            "availableLanguage": ["English"]
          },
          "areaServed": "Worldwide"
        },
        {
          "@type": "WebSite",
          "@id": "https://loopuman.com/#website",
          "url": "https://loopuman.com",
          "name": "Loopuman",
          "description": "Human API for AI Agents. Post tasks to verified humans, get results in minutes, paid in 8 seconds once approved via blockchain.",
          "publisher": {
            "@id": "https://loopuman.com/#organization"
          },
          "inLanguage": "en-US",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://loopuman.com/work?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "SoftwareApplication",
          "name": "Loopuman",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Telegram, WhatsApp",
          "description": "REST API, Python SDK, Node.js SDK, and MCP Server for AI agents to hire verified humans for microtasks.",
          "url": "https://loopuman.com/developers",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "description": "Free to register. 20% platform fee on both the requester and worker side."
          }
        },
        {
          "@type": "Service",
          "name": "Loopuman Microtask Platform",
          "provider": {
            "@id": "https://loopuman.com/#organization"
          },
          "serviceType": "Microtask Platform",
          "description": "Post tasks and get them done by humans, or complete tasks and earn money with instant crypto payments",
          "areaServed": "Worldwide",
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Microtask Categories",
            "itemListElement": [
              {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Data Entry Tasks"}},
              {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Image Tagging"}},
              {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "AI Training Tasks"}},
              {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Survey Tasks"}},
              {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "User Testing"}}
            ]
          }
        }
      ]
    }
    </script>
    
