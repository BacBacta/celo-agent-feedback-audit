{"chain":"celo","agentId":9343,"owner":"0x17277b29bdD80f44C9BF5F03AC837c9767Cf643a","agentWallet":"0x17277b29bdD80f44C9BF5F03AC837c9767Cf643a","tokenURI":"data:application/json;base64,","registration":{"type":"https://eips.ethereum.org/EIPS/eip-8004#registration-v1","name":"PixelMint AI","description":"PixelMint AI is a next-generation decentralized AI image generation and editing platform built on the Base and Celo networks. It empowers users to create stunning, high-quality images from text prompts or edit existing images using state-of-the-art AI models.\n\nKey Features:\n• Multi-Modal Generation: Supports standard text-to-image, single-image editing, and advanced dual-image reference editing.\n• Agent Mode (Gasless): Enjoy a seamless Web3 experience with our gasless Agent Mode, where our on-chain agent handles transaction fees for you.\n• Flexible Credit System: Interact via pay-per-generation using on-chain credits, or subscribe to cost-effective monthly plans (Starter, Pro, Premium) using USDC.\n• Decentralized Profiles: Secure on-chain usernames, automated referral rewards, and blockchain-verified generation history.\n\nWhether you are a casual creator or a professional designer, PixelMint AI provides the decentralized tools to bring your imagination to life.","image":"https://blob.8004scan.app/c9ceeb91ce1fee337644c8f1b7b5f932b109d23e381bfd0566850b4af838e7a9.jpg","services":[{"name":"The official web interface and DApp for PixelMint AI. Users can securely connect their wallets, manage subscriptions, and generate high-quality AI images directly through this platform.","endpoint":"https://pixelmintai.xyz/"}],"registrations":[],"supportedTrusts":["reputation"],"active":true,"x402support":true},"reputation":{"count":1,"average":79,"records":[{"client":"0xf9c63815A7396a45676cD6260856A10df66B2F0d","value":79,"tag1":"agentkarma_metadata","tag2":"v0.2","revoked":false}]},"explorer":{"celoscan":"https://celoscan.io/token/0x8004A169FB4a3325136EB29fA0ceB6D2e539a432?a=93