# Any Celo mainnet JSON-RPC endpoint. The public one works but is rate-limited;0
# a free Alchemy/Ankr/QuickNode key makes a full-history run much faster.

CELO_RPC_URL=https://forno.celo.org

# How far back to scan. "all" starts at the Reputation Registry deployment block.
# Otherwise a number of days, e.g. 30.
AUDIT_WINDOW=all

# Optional: cap on how many feedback files are fetched over HTTP when validating
# declared proofOfPayment. Set 0 to skip file fetching entirely.
MAX_FILE_FETCHES=2000
