{
  "name": "celo-agent-feedback-audit",
  "version": "0.4.0",
  "description": "Measures how much of the ERC-8004 agent reputation on Celo mainnet is backed by verifiable evidence — and how much is not.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/csv.mjs dist/csv.mjs",
    "audit": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "audit:dev": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "tsx test/analysis.test.ts",
    "typecheck": "tsc --noEmit",
    "counter-checks": "node counter-checks.mjs",
    "crosscheck": "node crosscheck.mjs",
    "verify-parties": "node verify-parties.mjs"
  },
  "dependencies": {
    "undici": "^8.10.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "tsx": "^4.19.0"
  }
}
