# Copy to .env and edit. Values here are read at startup; anything you set
# on the command line wins over the file:
#   AUDIT_WINDOW=30 npm run audit

# Any Celo mainnet JSON-RPC endpoint. The public one works but is rate-limited;
# a free Alchemy/Ankr/QuickNode key makes a full-history run much faster.
# A database-backed indexer, because forno's load-balanced nodes return
# inconsistent eth_getLogs results for identical immutable ranges — measured
# at 46/40/37 events against this endpoint's 77, on one 60,000-block window.
# The audit now refuses to run on an endpoint that cannot agree with itself.
CELO_RPC_URL=https://celo.blockscout.com/api/eth-rpc

# How far back to scan. "all" starts at the Reputation Registry deployment block.
# Otherwise a number of days, e.g. 30.
AUDIT_WINDOW=all

# Optional: cap on how many feedback files are fetched over HTTP when validating
# declared proofOfPayment. Set 0 to skip file fetching entirely.
MAX_FILE_FETCHES=2000

# Parallel eth_getLogs requests per wave. 5 is polite on a public endpoint;
# raise it with your own RPC key.
RPC_CONCURRENCY=5

# Where resumable scan progress is stored. Delete this folder to force a
# clean re-scan.
CACHE_DIR=data
